{
  "name": "@verneuil/dsh-opencode-go-usage",
  "version": "3.3.0",
  "main": "index.js",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "description": "OCG 余量查询：一个浮窗同时显示 DeepSeek 官方余额或 OpenCode Go 配额剩余（二选一）与 5 小时 / 本周 / 本月用量（官方 shell.overlay 席位，replaceRisk=none），点击刷新并闪边框反馈（成功长亮、失败闪红），拖动按锚线吸附；另带「OCG 余量查询」设置页（标签式：用量数据 / 浮窗管理 / 通用设置，含配额参考模型、金额计价币种、手动与自动刷新、三环显示数据自定义、双 Key 覆盖、用量明细）；模型清单与 USD/CNY 汇率自动获取，失败回退内置快照并点名报错。",
  "license": "MIT",
  "author": "verneuil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verneuil/dsh-opencode-go-usage.git"
  },
  "homepage": "https://github.com/verneuil/dsh-opencode-go-usage#readme",
  "bugs": {
    "url": "https://github.com/verneuil/dsh-opencode-go-usage/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode-go",
    "usage",
    "quota",
    "balance",
    "overlay"
  ],
  "meta": {
    "title": "OCG 余量查询",
    "description": "浮窗显示 DeepSeek 余额或 OpenCode Go 配额剩余，以及 5 小时 / 本周 / 本月用量。"
  },
  "type": "module",
  "engines": {
    "dsh": ">=0.1.7"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "files": [
    "index.js",
    "client.js",
    "go-fetch.js",
    "go-data.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
